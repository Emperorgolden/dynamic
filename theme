VIDEO_MARK_END="<!-- GHE_THEME_VIDEO_END -->"
FOOTER_MARK_START="<!-- GHE_THEME_FOOTER_START -->"
FOOTER_MARK_END="<!-- GHE_THEME_FOOTER_END -->"

# --- FIX: Detect if running on AWS to skip IMDSv2 interference ---
IS_AWS=false
if curl -s --max-time 2 http://169.254.169.254/latest/meta-data/ &>/dev/null; then
  IS_AWS=true
  warn "AWS environment detected. Applying AWS-compatible settings..."
fi

# --- Dependencies ---
if ! command -v ffmpeg &>/dev/null; then
  warn "ffmpeg is not installed."
  read -p "Do you want to install it now? (y/N): " install_ffmpeg
  if [[ "${install_ffmpeg:-}" =~ ^[Yy]$ ]]; then
    [[ ${EUID:-1000} -ne 0 ]] && SUDO_CMD="sudo" || SUDO_CMD=""
    log "Updating apt..."
    $SUDO_CMD apt-get update -y
    log "Installing packages: ffmpeg wget curl tar"
    $SUDO_CMD apt-get install -y ffmpeg wget curl tar
    log "ffmpeg installed successfully."
  else
    err "ffmpeg is required. Exiting."
    exit 1
  fi
else
  log "ffmpeg already installed."
fi

if ! command -v wget &>/dev/null && ! command -v curl &>/dev/null; then
  err "Neither wget nor curl available. Run: apt-get install -y wget curl"
  exit 1
fi

# --- FIX: Install/Update yt-dlp properly for Ubuntu 24 and all systems ---
install_ytdlp() {
  log "Installing/Updating yt-dlp to latest version..."

  # Preferred: direct binary (most reliable on all systems)
  if curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp \
      -o /usr/local/bin/yt-dlp --silent; then
    chmod a+rx /usr/local/bin/yt-dlp
    log "yt-dlp installed via binary."
  elif command -v pip3 &>/dev/null; then
    # Ubuntu 24 needs --break-system-packages
    pip3 install --upgrade yt-dlp --break-system-packages 2>/dev/null || \
    pip3 install --upgrade yt-dlp 2>/dev/null || true
  elif command -v pip &>/dev/null; then
    pip install --upgrade yt-dlp --break-system-packages 2>/dev/null || \
    pip install --upgrade yt-dlp 2>/dev/null || true
  elif command -v apt &>/dev/null; then
    apt-get install -y yt-dlp || true
  fi
}

if ! command -v yt-dlp &>/dev/null; then
  warn "yt-dlp not installed."
  install_ytdlp
else
  log "Updating yt-dlp to latest (fixes TikTok/social media changes)..."
  # FIX: Always update before use so TikTok JSON parsing works
  /usr/local/bin/yt-dlp -U 2>/dev/null || yt-dlp -U 2>/dev/null || install_ytdlp
fi

# --- Menu ---
echo
echo -e "${YELLOW}[1]${NC} Add custom background to the default theme"
echo -e "${YELLOW}[2]${NC} Install NookTheme and add custom background"
echo -e "${YELLOW}[3]${NC} Uninstall Theme and Restore Backup"
echo
read -p "Please choose an option [1-3]: " option

# --- Uninstall ---
if [[ "${option:-}" == "3" ]]; then
  log "Uninstall selected."

  if [[ -f "$BACKUP" ]]; then
    log "Restoring wrapper backup: $BACKUP"
    mv "$BACKUP" "$WRAPPER"
    log "Wrapper restored."
  else
    warn "No wrapper backup found. Removing injected blocks..."
    sed -i "/$HEAD_MARK_START/,/$HEAD_MARK_END/d" "$WRAPPER" || true
    sed -i "/$VIDEO_MARK_START/,/$VIDEO_MARK_END/d" "$WRAPPER" || true
    sed -i "/$FOOTER_MARK_START/,/$FOOTER_MARK_END/d" "$WRAPPER" || true
  fi

  if [[ -f "$LOGIN_FORM_BACKUP" ]]; then
    log "Restoring LoginFormContainer.tsx backup..."
    mv "$LOGIN_FORM_BACKUP" "$LOGIN_FORM"
  else
    warn "No LoginFormContainer.tsx backup found. Leaving current version."
  fi

  log "Removing custom assets..."
  rm -f "$MEDIA_DIR/custom_bg."* || true
  rm -f "$CSS_DIR/custom-background.css" "$CSS_DIR/login-theme.css" || true

  log "Clearing Pterodactyl caches..."
  cd "$PANEL_DIR"
  php artisan view:clear || true
  php artisan config:clear || true
  php artisan cache:clear || true
  php artisan queue:restart || true

  log "Theme uninstalled successfully."
  exit 0
fi

# --- Get media URL ---
read -p "Enter the direct URL for the background media (image/video): " media_url
if [[ -z "${media_url:-}" ]]; then
  err "No URL provided. Exiting."
  exit 1
fi

log "Processing media URL..."

ORIGINAL_FILE="$MEDIA_DIR/original.mp4"

# FIX: Download with anti-suspension settings (rate limit + sleep + no bot headers)
# FIX: Added geo-block fallback with cookies for AWS/US IPs
download_media() {
  local url="$1"
  local out="$2"

  # Build common yt-dlp args
  # --limit-rate: prevents abuse detection on cloud providers
  # --sleep-interval: avoids triggering rate limits (helps on AWS)
  # --no-check-certificates: fixes SSL issues on some VPS setups
  local YTDLP_ARGS=(
    -f "bestvideo+bestaudio/best"
    --merge-output-format mp4
    -o "$out"
    --limit-rate 5M
    --sleep-interval 1
    --no-check-certificates
    --user-agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
  )

  log "Attempting download with yt-dlp..."
  if yt-dlp "${YTDLP_ARGS[@]}" "$url"; then
    log "Download successful."
    return 0
  fi

  # Fallback: try with cookies from browser (helps if IP is geo-blocked on AWS)
  warn "First attempt failed. Trying with cookie fallback..."
  if yt-dlp "${YTDLP_ARGS[@]}" --cookies-from-browser chrome "$url" 2>/dev/null; then
    log "Download successful with cookie fallback."
    return 0
  fi

  # Last resort: try direct curl/wget for plain image URLs
  warn "yt-dlp failed. Trying direct curl download..."
  if curl -L --max-time 60 --retry 3 \
      -A "Mozilla/5.0" \
      -o "$out" "$url" 2>/dev/null; then
    log "Direct curl download succeeded."
    return 0
  fi

  err "All download methods failed."
  return 1
}

if ! download_media "$media_url" "$ORIGINAL_FILE"; then
  exit 1
fi

# Detect file type
if file "$ORIGINAL_FILE" | grep -qi "image"; then
  media_type="image"
else
  media_type="video"
fi

log "Media detected: $media_type"

# Validate video
if [[ "$media_type" == "video" ]]; then
  if ! file "$ORIGINAL_FILE" | grep -qiE "MP4|video|MPEG"; then
    err "Downloaded file does not appear to be a valid video."
    exit 1
  fi
fi

# --- Process media ---
if [[ "$media_type" == "image" ]]; then
  FINAL_FILE="$MEDIA_DIR/custom_bg.jpg"
  log "Processing image..."
  mv "$ORIGINAL_FILE" "$FINAL_FILE"
  saved_filename="custom_bg.jpg"
else
  FINAL_FILE="$MEDIA_DIR/custom_bg.webm"
  log "Converting video to 1080p WebM..."
  if ! ffmpeg -hide_banner -y -i "$ORIGINAL_FILE" \
    -vf "scale=-2:1080" \
    -c:v libvpx-vp9 -crf 30 -b:v 0 -an \
    "$FINAL_FILE"; then
    err "Video conversion failed."
    exit 1
  fi
  rm -f "$ORIGINAL_FILE"
  saved_filename="custom_bg.webm"
fi

# --- Generate background CSS ---
log "Generating custom background CSS..."
CSS_FILE="$CSS_DIR/custom-background.css"

if [[ "$media_type" == "image" ]]; then
cat <<EOF > "$CSS_FILE"
body {
  background: url('/assets/media/$saved_filename') no-repeat center center fixed !important;
  background-size: cover !important;
}
EOF
else
cat <<EOF > "$CSS_FILE"
#dynamic-background-video {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: -10;
  object-fit: cover;
  pointer-events: none;
}
body { background-color: #000 !important; }
EOF
fi

# --- Liquid Glass CSS (fully preserved + compatibility fixes) ---
log "Writing Liquid Glass login CSS..."
