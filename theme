#!/bin/bash
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

LOG_FILE="/var/log/ghe-theme-deployer.log"

log()  { echo -e "${CYAN}[INFO]${NC}  $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC}  $*"; }
err()  { echo -e "${RED}[ERROR]${NC} $*"; }

mkdir -p "$(dirname "$LOG_FILE")" || true
exec > >(tee -a "$LOG_FILE") 2>&1

trap 'err "Script failed at line $LINENO. Check log: $LOG_FILE"' ERR

# =============================================================================
# CHANGES FROM PREVIOUS VERSION:
# 1. Node.js: Added NODE_OPTIONS=--openssl-legacy-provider for Node 17+ / Ubuntu 24
# 2. Node.js: Added nvm auto-install if not present (works on all distros)
# 3. Node.js: Falls back to system node gracefully instead of crashing
# 4. yt-dlp: Added --update-to latest before every download (fixes TikTok JSON errors)
# 5. yt-dlp: Added cookies + user-agent fallback for geo-blocked VPS IPs
# 6. yt-dlp: pip install now uses --break-system-packages for Ubuntu 24
# 7. AWS fix: Added httpd / apache2 detection + port 80 check before nginx ops
# 8. AWS fix: Added IMDSv2 detection to skip AWS-specific network interference
# 9. Suspension prevention: Removed any outbound scraping/bot-like headers
# 10. Suspension prevention: Rate-limiting media downloads with --limit-rate
# 11. Suspension prevention: Added --sleep-interval on yt-dlp to avoid triggering abuse detection
# 12. CSS: Added Safari -webkit- prefix support for backdrop-filter (fixes AWS CloudFront)
# 13. CSS: Improved glass rendering on Chromium-based panels (saturation fix)
# 14. Liquid glass: All effects preserved exactly, only compatibility improved
# 15. Build: yarn build now sets NODE_OPTIONS for OpenSSL legacy on Node 17+/Ubuntu 24
# 16. Uninstall: Now also cleans up NookTheme remnants safely
# 17. General: Compatible with Ubuntu 20, 22, 24 + Debian 11/12 + any VPS provider
# =============================================================================

# --- Animated Intro ---
type_text() {
  local text="$1"
  local delay="${2:-0.02}"
  for ((i=0; i<${#text}; i++)); do
    echo -ne "${text:$i:1}"
    sleep $delay
  done
  echo
}

loading() {
  echo -ne "${CYAN}Initializing"
  for i in {1..3}; do
    sleep 0.3
    echo -ne "."
  done
  echo -e "${NC}"
}

clear
type_text "${GREEN}>>> Booting Golden Hosting Enterprise..." 0.03
loading
type_text "${GREEN}>>> Preparing Theme Deployer..." 0.02
loading
sleep 0.3
clear

