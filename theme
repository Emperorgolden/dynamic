# --- Function: Inject wrapper ---
inject_wrapper() {
  log "Injecting code into wrapper (safe mode)..."

  [[ ! -f "$WRAPPER" ]] && { err "wrapper.blade.php not found at $WRAPPER"; exit 1; }
  [[ ! -f "$BACKUP" ]] && { log "Creating backup: $BACKUP"; cp "$WRAPPER" "$BACKUP"; }

  # Remove old blocks (idempotent)
  sed -i "/$HEAD_MARK_START/,/$HEAD_MARK_END/d" "$WRAPPER" || true
  sed -i "/$VIDEO_MARK_START/,/$VIDEO_MARK_END/d" "$WRAPPER" || true
  sed -i "/$FOOTER_MARK_START/,/$FOOTER_MARK_END/d" "$WRAPPER" || true

  if ! grep -q "</head>" "$WRAPPER"; then
    err "Could not find </head> in wrapper.blade.php. Aborting."
    exit 1
  fi

  # Inject CSS links before </head>
  sed -i "s#</head>#$HEAD_MARK_START\n<link rel='stylesheet' href='/assets/css/custom-background.css'>\n<link rel='stylesheet' href='/assets/css/login-theme.css'>\n$HEAD_MARK_END\n</head>#i" "$WRAPPER"

  # Inject video after <body>
  if [[ "$media_type" == "video" ]]; then
    VIDEO_TAG="<video autoplay muted loop playsinline id=\"dynamic-background-video\"><source src=\"/assets/media/$saved_filename\" type=\"video/webm\"></video>"

    if ! grep -Eq "<body[^>]*>" "$WRAPPER"; then
      err "Could not find <body> tag in wrapper.blade.php. Aborting."
      exit 1
    fi

    awk -v vstart="$VIDEO_MARK_START" -v vend="$VIDEO_MARK_END" -v vtag="$VIDEO_TAG" '
      BEGIN{done=0}
      {
        print
        if (!done && $0 ~ /<body[^>]*>/) {
          print vstart
          print vtag
          print vend
          done=1
        }
      }
    ' "$WRAPPER" > "$WRAPPER.tmp" && mv "$WRAPPER.tmp" "$WRAPPER"
  fi

  # Footer (idempotent)
  FOOTER_HTML="All rights reserved by Golden Hosting Enterprise © 2025 -2026"
  if grep -q "$FOOTER_HTML" "$WRAPPER"; then
    log "Footer already present, skipping."
  else
    if grep -q "@yield('below-container')" "$WRAPPER"; then
      sed -i "/@yield('below-container')/a $FOOTER_MARK_START\n<div class=\"text-center text-xs text-neutral-500 mb-4\">${FOOTER_HTML}</div>\n$FOOTER_MARK_END" "$WRAPPER"
    else
      echo -e "\n$FOOTER_MARK_START\n<div class=\"text-center text-xs text-neutral-500 mb-4\">${FOOTER_HTML}</div>\n$FOOTER_MARK_END" >> "$WRAPPER"
    fi
  fi

  log "Wrapper injection done."
}

# --- Node.js compatibility helper ---
# FIX: Added nvm auto-install + NODE_OPTIONS for Ubuntu 24 / Node 17+ OpenSSL fix
use_node16() {
  warn "Pterodactyl frontend works best with Node 16"

  export NVM_DIR="/root/.nvm"

  # Auto-install nvm if missing (works on Ubuntu 20/22/24, Debian, any VPS)
  if [ ! -s "$NVM_DIR/nvm.sh" ]; then
    log "nvm not found. Installing nvm automatically..."
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash || true
    export NVM_DIR="/root/.nvm"
  fi

  if [ -s "$NVM_DIR/nvm.sh" ]; then
    log "Loading nvm..."
    # shellcheck source=/dev/null
    . "$NVM_DIR/nvm.sh"
    log "Installing and switching to Node 16..."
    nvm install 16 &>/dev/null || true
    nvm use 16 || true
  else
    warn "nvm still not available. Will try system node with OpenSSL legacy flag..."
  fi
}

# --- Build frontend assets ---
build_assets() {
  log "Building panel frontend assets with Node + Yarn..."
  cd "$PANEL_DIR"

  use_node16

  # FIX: Set NODE_OPTIONS for Node 17+ / Ubuntu 24 OpenSSL compatibility
  # This is what makes the build work on Ubuntu 24 which ships Node 18+
  local node_ver major
  node_ver="$(node -v 2>/dev/null || echo "v0.0.0")"
  major="${node_ver#v}"
  major="${major%%.*}"

  if [[ "$major" -ge 17 ]] 2>/dev/null; then
    warn "Node $node_ver detected (>=17). Setting OpenSSL legacy provider for Webpack..."
    export NODE_OPTIONS="--openssl-legacy-provider"
  else
    unset NODE_OPTIONS 2>/dev/null || true
  fi

  [[ ${EUID:-1000} -ne 0 ]] && SUDO_CMD="sudo" || SUDO_CMD=""

  if [[ -z "$major" || "$major" != "16" ]]; then
    warn "Detected Node.js $node_ver — Pterodactyl prefers Node 16.x but will try anyway."
  else
    log "Node.js version OK: $node_ver"
  fi

  # Ensure Yarn
  if ! command -v yarn &>/dev/null; then
    warn "yarn not installed. Installing..."
    if command -v npm &>/dev/null; then
      $SUDO_CMD npm install -g yarn
    else
      err "npm not available to install yarn."
      return 1
    fi
  fi

  log "Node.js: $(node -v 2>/dev/null || echo 'unknown')"
  log "Yarn: $(yarn -v 2>/dev/null || echo 'unknown')"

  log "Running yarn install..."
  yarn install || warn "yarn install had warnings, continuing..."

  log "Running yarn build:production (this may take a while)..."
  if ! yarn build:production; then
    warn "yarn build:production failed. The theme CSS/wrapper changes are still applied."
    warn "You may need to manually build: cd $PANEL_DIR && yarn build:production"
    return 0
  fi

  log "Frontend assets built successfully."
}

# --- Option 2: Install NookTheme ---
if [[ "${option:-}" == "2" ]]; then
  log "Installing NookTheme..."
  cd "$PANEL_DIR"

  php artisan down

  log "Downloading + extracting NookTheme..."
  if command -v curl &>/dev/null; then
    curl -L https://github.com/Nookure/NookTheme/releases/latest/download/panel.tar.gz | tar -xz
  else
    wget -qO- https://github.com/Nookure/NookTheme/releases/latest/download/panel.tar.gz | tar -xz
  fi

  log "Fixing permissions..."
  chmod -R 755 storage/* bootstrap/cache

  export COMPOSER_ALLOW_SUPERUSER=1

  log "Running composer install..."
  composer install --no-dev --optimize-autoloader --no-interaction

  log "Running migrations + seed..."
  php artisan migrate --seed --force

  log "Clearing caches + restarting queue..."
  php artisan view:clear
  php artisan config:clear
  php artisan queue:restart

  php artisan up
  chown -R www-data:www-data .

  log "NookTheme installation completed."
fi

# Apply glass login form
update_login_form_tsx

# Inject wrapper CSS/video
inject_wrapper

# Build frontend
build_assets

log "Setting permissions on assets..."
chown -R www-data:www-data "$PANEL_DIR/public/assets"

log "Clearing caches and restarting queue..."
cd "$PANEL_DIR"
php artisan view:clear
php artisan config:clear
php artisan cache:clear
php artisan queue:restart

echo
echo -e "${GREEN}雪 Theme deployment complete.${NC}"
log "Done."
